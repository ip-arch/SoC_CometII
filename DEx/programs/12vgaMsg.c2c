var VGA     = 0xC000;
var COLOR   = 0xF000;
var VGACLS  = 0x0FEC;

var msg[32] = { 0x48, 0x65, 0x6C, 0x6C, 0x6F, 0x20, 0x20, 0x20,
                0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20,
                0x20, 0x20, 0x20, 0x20, 0x20, 0x48, 0x6F, 0x67,
                0x65, 0x6E, 0x69, 0x6D, 0x75, 0x73, 0x68, 0x69 };

proc vgaCls()
{
  *(VGA|VGACLS) = COLOR;
  while (*(VGA|VGACLS));
}

main()
{
  var i;
  vgaCls();
  for(i=0;i<16;i++) *(VGA+i)    = msg[i   ] | COLOR;
  for(i=0;i<16;i++) *(VGA+i+128)= msg[i+16] | COLOR;
  halt;
}

