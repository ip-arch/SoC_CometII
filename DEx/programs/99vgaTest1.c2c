var VGA=0xC000;
var COLOR=0xF000;
var numToAscii=0x30;
proc vgaGetAdrs(xin, yin)
{
  return VGA | ((yin & 0x1F)<<7) | (xin & 0x7F);
}

proc inc10(input) {
  if (input>8) return 0;
  else         return input+1;
}

main()
{
  var count=0, x, y;
  for(y = 0 ; y < 30 ; y++){
    count = 0;
    for(x = 0; x < 80; x++){
      *(vgaGetAdrs(x,y))= COLOR | numToAscii | count;
      count = inc10(count);
    }
  }
  halt;
}
