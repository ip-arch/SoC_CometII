TEST	START	MAIN
RES	DS	1
ERRRES	DS	1
ERROR	ST	GR7,ERRRES
	HLT
MAIN	LAD	GR15,STACKEND
	LAD	GR14,ITABLE
;
	LAD	GR7,#0001  ; OVERFLOW TEST FOR SUBA
	LD	GR0,=#FFFF
	LD	GR1,=#7FFF
	SUBA	GR1,GR0
	ST	GR1,RES
	JZE	ERROR
	JPL	ERROR
	JOV	M1
	JUMP	ERROR
M1
	CPL	GR1,=#8000
	JNZ	ERROR
;
	LAD	GR7,#0002  ; OVERFLOW TEST FOR ADDA
	ADDA	GR1,GR0
	ST	GR1,RES
	JZE	ERROR
	JMI	ERROR
	JOV	M2
	JUMP	ERROR
M2
	CPL	GR1,=#7FFF
	JNZ	ERROR
;
	LAD	GR7,#0003  ; OVERFLOW TEST FOR SUBL
	SUBL	GR1,GR0
	ST	GR1,RES
	JZE	ERROR
	JPL	ERROR
	JOV	M3
	JUMP	ERROR
M3
	CPL	GR1,=#8000
	JNZ	ERROR
;
	LAD	GR7,#0004  ; OVERFLOW TEST FOR ADDL
	ADDL	GR1,GR0
	ST	GR1,RES
	JZE	ERROR
	JMI	ERROR
	JOV	M4
	JUMP	ERROR
M4
	CPL	GR1,=#7FFF
	JNZ	ERROR
;
	LAD	GR7,#0005  ; NON OVERFLOW TEST FOR SUBL
	LD	GR0,=#FFFF
	LD	GR1,=#FFFF
	SUBL	GR1,GR0
	ST	GR1,RES
	JNZ	ERROR
	JMI	ERROR
	JPL	ERROR
	JOV	ERROR
	CPL	GR1,=#0000
	JNZ	ERROR
;
	LAD	GR7,#0006  ; NON OVERFLOW TEST FOR ADDL
	ADDL	GR1,GR0
	ST	GR1,RES
	JZE	ERROR
	JPL	ERROR
	JOV	ERROR
	CPL	GR1,=#FFFF
	JNZ	ERROR
;
	LAD	GR7,#0007  ; NON OVERFLOW TEST FOR SUBA
	SUBA	GR1,GR0
	ST	GR1,RES
	JNZ	ERROR
	JPL	ERROR
	JOV	ERROR
	CPL	GR1,=#0000
	JNZ	ERROR
;
	LAD	GR7,#0008  ; NON OVERFLOW TEST FOR ADDA
	ADDA	GR1,GR0
	ST	GR1,RES
	JZE	ERROR
	JPL	ERROR
	JOV	ERROR
	CPL	GR1,=#FFFF
	JNZ	ERROR
;
	LAD	GR7,#0009  ; OVERFLOW TEST FOR CPA
	LD	GR0,=#8000
	LD	GR1,=1
	CPA	GR1,GR0
	ST	GR1,RES
	JZE	ERROR
	JMI	ERROR
	JOV	ERROR
	CPL	GR1,=1
	JNZ	ERROR
;
	LAD	GR7,#000A  ; NON OVERFLOW TEST FOR CPL
	CPL	GR1,GR0
	ST	GR1,RES
	JZE	ERROR
	JPL	ERROR
	JOV	ERROR
	CPL	GR1,=1
	JNZ	ERROR

	HLT
	RET
ITABLE	DS	1
	DC	SVCIN
	DC	SVCOUT
SVCIN	RETI
SVCOUT	RETI
	DS	10
STACKEND
	END
