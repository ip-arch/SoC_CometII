TEST	START	MAIN
RES	DS	1
ERRRES	DS	1
ERROR	ST	GR7,ERRRES
	HLT
MAIN	LAD	GR15,STACKEND
	LAD	GR14,ITABLE
	LD	GR0,=1
	LAD	GR1,2
	LAD	GR2,1,GR1
	LAD	GR3,1,GR2
	LAD	GR4,1,GR3
	LAD	GR5,1,GR4
	LAD	GR6,1,GR5
;
	LAD	GR7,#0001  ; GR0 WILL NOT AFFECT
	PUSH	1
	POP	GR0
	ST	GR0,RES
	CPL	GR0,=1
	JNZ	ERROR
;
	LAD	GR7,#0002  ; 
	PUSH	1,GR1
	POP	GR0
	ST	GR0,RES
	CPL	GR0,GR2
	JNZ	ERROR
;
	LAD	GR7,#0003  ; 
	PUSH	1,GR2
	POP	GR0
	ST	GR0,RES
	CPL	GR0,GR3
	JNZ	ERROR
;
	LAD	GR7,#0004  ; 
	PUSH	1,GR3
	POP	GR0
	ST	GR0,RES
	CPL	GR0,GR4
	JNZ	ERROR
;
	LAD	GR7,#0005  ; 
	PUSH	1,GR4
	POP	GR0
	ST	GR0,RES
	CPL	GR0,GR5
	JNZ	ERROR
;
	LAD	GR7,#0006  ; 
	PUSH	1,GR5
	POP	GR0
	ST	GR0,RES
	CPL	GR0,GR6
	JNZ	ERROR
;
	LAD	GR7,#0007  ; 
	PUSH	1,GR6
	POP	GR0
	ST	GR0,RES
	CPL	GR0,=8
	JNZ	ERROR
;
	LAD	GR7,#0008  ; 
	PUSH	1,GR7
	POP	GR0
	ST	GR0,RES
	CPL	GR0,=9
	JNZ	ERROR
;
	LAD	GR7,#0009  ; 
	LAD	GR0,#AA55
	CALL	CALLTEST
	CPL	GR0,=#55AA
	JNZ	ERROR
	HLT
CALLTEST
	XOR	GR0,=#FFFF
	RET
ITABLE	DS	1
	DC	SVCIN
	DC	SVCOUT
SVCIN	RETI
SVCOUT	RETI
	DS	10
STACKEND
	END
